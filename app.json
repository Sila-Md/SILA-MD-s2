{
  "name": "SILA MD Bot",
  "description": "Powerful WhatsApp Bot with Multi-Device Support",
  "repository": "https://github.com/SilaTechB/sila-md-bot",
  "logo": "https://files.catbox.moe/jwmx1j.jpg",
  "keywords": ["whatsapp-bot", "multi-device", "sila-tech", "baileys", "heroku"],
  "env": {
    "SESSION_ID": {
      "description": "Your Mega.nz session ID starting with 'Sila~'",
      "value": "",
      "required": true
    },
    "PREFIX": {
      "description": "Bot command prefix",
      "value": ".",
      "required": false
    },
    "BOT_NAME": {
      "description": "Your bot name",
      "value": "SILA-MD-s1",
      "required": false
    },
    "OWNER_NUMBER": {
      "description": "Bot owner number",
      "value": "255612491554",
      "required": false
    },
    "npm_config_legacy_peer_deps": {
      "description": "Fix dependency conflicts",
      "value": "true",
      "required": true
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
    }
  },
  "stack": "heroku-24"
}
